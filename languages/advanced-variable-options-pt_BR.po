msgid " Applies to %d variation:"
msgid_plural " Applies to %d variations:"
msgstr[0] " Aplica-se a %d variação:"
msgstr[1] " Aplicam-se a %d variações:"

msgid " No matching variations found for this option."
msgstr " Nenhuma variação correspondente foi encontrada para esta opção."

msgid "%d image selected."
msgid_plural "%d images selected."
msgstr[0] "%d imagem selecionada."
msgstr[1] "%d imagens selecionadas."

msgid "...and %d more."
msgstr "...e mais %d."

msgid "Add image galleries to any available product attribute option. Example: Color > Black can have multiple images, but this also works for material, texture, model, or any custom attribute."
msgstr "Adicione galerias de imagens a qualquer opção de atributo disponível. Exemplo: Cor > Preto pode ter várias imagens; isso também funciona para material, textura, modelo ou qualquer atributo personalizado."

msgid "Add images"
msgstr "Adicionar imagens"

msgid "Advanced Variable Options"
msgstr "Opções Avançadas de Variação"

msgid "Attribute Galleries"
msgstr "Galerias de atributos"

msgid "Attribute image galleries, image swatches, and size availability controls for WooCommerce variable products."
msgstr "Galerias de imagens por atributo, amostras de imagens e controles de disponibilidade de tamanhos para produtos variáveis do WooCommerce."

msgid "Clear"
msgstr "Limpar"

msgid "Close"
msgstr "Fechar"

msgid "Image 1 is the primary image. Drag images to change their order."
msgstr "A imagem 1 é a imagem principal. Arraste as imagens para alterar a ordem."

msgid "No default option"
msgstr "Nenhuma opção padrão"

msgid "No variable attributes found. Add attributes to the product, enable \"Used for variations\", save the product, then return here."
msgstr "Nenhum atributo variável foi encontrado. Adicione atributos ao produto, ative \"Usado para variações\", salve o produto e volte aqui."

msgid "Not marked as used for variations. Images can be saved here, but storefront swatches are generated from variation attributes."
msgstr "Não está marcado como usado para variações. As imagens podem ser salvas aqui, mas as amostras da loja são geradas pelos atributos das variações."

msgid "Primary"
msgstr "Principal"

msgid "Product gallery thumbnails"
msgstr "Miniaturas da galeria do produto"

msgid "Product option"
msgstr "Opção do produto"

msgid "Product options"
msgstr "Opções do produto"

msgid "Remove image"
msgstr "Remover imagem"

msgid "Select attribute gallery images"
msgstr "Selecionar imagens da galeria do atributo"

msgid "Size"
msgstr "Tamanho"

msgid "Use selected images"
msgstr "Usar imagens selecionadas"

msgid "Use this option as the default storefront image option"
msgstr "Usar esta opção como imagem padrão da loja"

msgid "Used for variations. Choose one option as the storefront default if this is your visual attribute."
msgstr "Usado para variações. Escolha uma opção como padrão da loja se este for o atributo visual."
